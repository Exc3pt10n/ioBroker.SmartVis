    "native": {
        "port": 8099,
        "bind": "0.0.0.0",
        "language": "de",
        "ignoreAdapters": "system,admin,discovery,backitup,history,influxdb,sql,web,vis,vis-2,material,iot",
        "rediscoverDelay": 10,
        "allowEdit": true
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.devices",
            "type": "state",
            "common": {
                "role": "value",
                "name": "Erkannte Geräte",
                "type": "number",
                "read": true,
                "write": false,
                "def": 0
            },
            "native": {}
        },
        {
            "_id": "info.clients",
            "type": "state",
            "common": {
                "role": "value",
                "name": "Verbundene Clients",
                "type": "number",
                "read": true,

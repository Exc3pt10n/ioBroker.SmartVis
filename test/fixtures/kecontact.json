    "type": "channel",
    "common": {
      "name": "miscellaneous automatics"
    },
    "native": {}
  },
  "kecontact.0.automatic.photovoltaics": {
    "_id": "kecontact.0.automatic.photovoltaics",
    "type": "state",
    "common": {
      "name": "photovoltaics automatic enabled",
      "type": "boolean",
      "role": "switch.mode.auto",
      "read": true,
      "write": true,
      "def": true,
      "desc": "Switch to load vehicle according to surplus of photovoltaics (true); otherwise load with maximum power (false)."
    },
    "native": {}
  },
  "kecontact.0.automatic.pauseWallbox": {
    "_id": "kecontact.0.automatic.pauseWallbox",
    "type": "state",
    "common": {
      "name": "pause charging of vehicle",
      "type": "boolean",
      "role": "switch.power",
      "read": true,
      "write": true,
      "def": false,
      "desc": "Switch to stop charging of vehicle. This switch has higher priority than photovoltaics and should be used to stop charging of vehicle"
    },
    "native": {}
  },
  "kecontact.0.automatic.targetSoC": {
    "_id": "kecontact.0.automatic.targetSoC",
    "type": "state",
    "common": {
      "name": "vehicle shall be charged to that SoC without PV automatics",
      "type": "number",
      "role": "level",
      "unit": "%",
      "read": true,
      "write": true,
      "def": 0,
      "desc": "Set this value to temporarily charge vehicle without PV automatics unless vehicle SoC (state of charge) has reached this value"
    },
    "native": {}
  },
  "kecontact.0.automatic.resetTargetSoC": {
    "_id": "kecontact.0.automatic.resetTargetSoC",
    "type": "state",
    "common": {
      "name": "reset target SoC after reaching this value",
      "type": "boolean",
      "role": "switch",
      "read": true,
      "write": true,
      "def": true,
      "desc": "set this option if taget SoC should be cleared after target SoC is reached by vehible"
    },
    "native": {}
  },
  "kecontact.0.automatic.addPower": {
    "_id": "kecontact.0.automatic.addPower",
    "type": "state",
    "common": {
      "name": "additional regard to run charging session",
      "type": "number",
      "role": "level.max",
      "unit": "W",
      "read": true,
      "write": true,
      "def": 0,
      "desc": "additional grid consumption to run charging session (> 0) or surplus to be reservied for other belongings (> 0)"
    },
    "native": {}
  },
